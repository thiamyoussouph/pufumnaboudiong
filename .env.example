# ── Base de données MySQL ──────────────────────────────
# Format : mysql://UTILISATEUR:MOTDEPASSE@HOTE:PORT/NOM_BASE
DATABASE_URL="mysql://root:password@localhost:3306/sillage"

# ── NextAuth ───────────────────────────────────────────
# Génère un secret avec : openssl rand -base64 32
NEXTAUTH_SECRET="remplace-par-un-secret-long-et-aleatoire"
NEXTAUTH_URL="http://localhost:3000"

# ── Cloudinary (photos des parfums) ────────────────────
CLOUDINARY_CLOUD_NAME="ton-cloud-name"
CLOUDINARY_API_KEY="ta-api-key"
CLOUDINARY_API_SECRET="ton-api-secret"

# ── Admin par défaut (utilisé par le seed) ─────────────
ADMIN_EMAIL="admin@sillage.sn"
ADMIN_PASSWORD="sillage2026"

# ── PayDunya (paiement) ─────────────────────────────────
# Mode : "sandbox" pour tester, "live" pour la production
PAYDUNYA_MODE="sandbox"
PAYDUNYA_MASTER_KEY="ta-master-key"
PAYDUNYA_PRIVATE_KEY="ta-private-key"
PAYDUNYA_PUBLIC_KEY="ta-public-key"
PAYDUNYA_TOKEN="ton-token"
